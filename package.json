{
  "name": "last-light-coop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "start": "NODE_ENV=production node server/index.js",
    "setup:admin": "node scripts/setup-admin.mjs",
    "setup:staff": "node scripts/setup-staff.mjs",
    "persistence": "node scripts/persistence.mjs",
    "build": "vite build",
    "build:html": "vite build --mode standalone",
    "serve:html": "CLIENT_DIST=html-dist CLIENT_ENTRY=standalone.html NODE_ENV=production node server/index.js",
    "test": "node --test",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.13.0",
    "cannon-es": "^0.20.0",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.1.7",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
